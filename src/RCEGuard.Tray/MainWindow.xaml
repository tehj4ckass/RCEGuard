<Window x:Class="RCEGuard.Tray.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RCEGuard" Width="1040" Height="600" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterScreen" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- The state at a glance: the same colour as the icon in the notification area. -->
        <Border x:Name="StateBar" DockPanel.Dock="Top" Padding="16,12" Background="#757575">
            <StackPanel>
                <TextBlock Text="{Binding State.Headline}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding State.Detail}" Foreground="White" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Profiles in lockdown, each with the finding that caused it and the way out. -->
        <Border DockPanel.Dock="Top" Padding="16,10" Background="#FDECEA" BorderBrush="#C62828" BorderThickness="0,0,0,1"
                Visibility="{Binding HasLockdowns, Converter={StaticResource Visible}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="In lockdown" />
                <ItemsControl ItemsSource="{Binding Lockdowns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Release ..." Padding="12,3" Margin="12,0,0,0" VerticalAlignment="Top"
                                        Tag="{Binding Profile}" Click="OnReleaseClick"
                                        ToolTip="Ends the lockdown. Windows asks for an administrator." />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="16,8">
            <Button DockPanel.Dock="Right" Content="Open data folder" Padding="12,3" Click="OnOpenFolderClick" />
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#555555">
                <Run Text="Findings and log of the guard service: " /><Run Text="{Binding DataDirectory, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>

        <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" Margin="16,8,16,0" Foreground="#C62828" TextWrapping="Wrap"
                   Text="{Binding Problem}" />

        <ListView x:Name="FindingList" Margin="16,12,16,0" ItemsSource="{Binding Findings}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SeverityText}" Value="CRITICAL">
                            <Setter Property="Foreground" Value="#B71C1C" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SeverityText}" Value="HIGH">
                            <Setter Property="Foreground" Value="#BF5B00" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Notifies}" Value="False">
                            <Setter Property="Foreground" Value="#666666" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time" Width="140" DisplayMemberBinding="{Binding TimeText}" />
                    <GridViewColumn Header="Rule" Width="46" DisplayMemberBinding="{Binding Rule}" />
                    <GridViewColumn Header="Severity" Width="76" DisplayMemberBinding="{Binding SeverityText}" />
                    <GridViewColumn Header="Profile" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Profile}" Style="{StaticResource Cell}" /></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="What happened" Width="350">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Summary}" Style="{StaticResource Cell}" /></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="What the guard did" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding ActionText}" Style="{StaticResource Cell}" /></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Again" Width="50" DisplayMemberBinding="{Binding RepeatsText}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
