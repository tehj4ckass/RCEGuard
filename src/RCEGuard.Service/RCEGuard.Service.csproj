<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Windows service (also runs in a console): reads the Sysmon log, applies the rules, acts on findings. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>RCEGuard.Service</RootNamespace>
    <AssemblyName>RCEGuard.Service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RCEGuard.Core\RCEGuard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests replace the log subscription of the worker to see what it does when nothing is delivered. -->
    <InternalsVisibleTo Include="RCEGuard.Service.Tests" />
  </ItemGroup>

</Project>
